<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/deck_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Top Bar: Horizon Badge and Read Next Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/qc_horizon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/ink_soft"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/qc_btn_spark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_button_bg"
            android:fontFamily="monospace"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="☆ Read Next"
            android:textColor="@color/ink_soft"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Card Job Headline (for How-To Craft Cards) -->
    <TextView
        android:id="@+id/qc_job"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/literata"
        android:lineSpacingMultiplier="1.25"
        android:textColor="@color/ink"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Quote Text -->
    <TextView
        android:id="@+id/qc_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/literata"
        android:lineSpacingMultiplier="1.38"
        android:textColor="@color/ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Attribution -->
    <TextView
        android:id="@+id/qc_attribution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif"
        android:lineSpacingMultiplier="1.25"
        android:textColor="@color/ink_soft"
        android:textSize="13.5sp" />

    <!-- Collapsible Companion Note Toggle Button -->
    <TextView
        android:id="@+id/qc_btn_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/chip_button_bg"
        android:fontFamily="monospace"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="▾ Read Companion Note"
        android:textColor="@color/ink_soft"
        android:textSize="11.5sp" />

    <!-- Collapsible Companion Note Body -->
    <LinearLayout
        android:id="@+id/qc_note_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/note_bg"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/qc_tier1_kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="THE PREDICAMENT"
            android:textAllCaps="true"
            android:textColor="@color/slide_hook"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/qc_tier1_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/literata"
            android:lineSpacingMultiplier="1.42"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/qc_tier2_kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="THE MIRROR"
            android:textAllCaps="true"
            android:textColor="@color/slide_hook"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/qc_tier2_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/literata"
            android:lineSpacingMultiplier="1.42"
            android:textColor="@color/ink"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/rule" />

    <!-- Footer: Tags and Read in Daily action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/qc_tags_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/qc_tags_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/qc_btn_open_daily"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:text="Read in Daily →"
            android:textColor="@color/ink_soft"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
