<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <!-- Top Header Bar: Badge Pill on Left, Step Counter on Right -->
        <LinearLayout
            android:id="@+id/slide_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hook_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shelf_badge"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="@color/shelf_badge_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/slide_step_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textColor="@color/ink_soft"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Kicker / Book Title: clean single line, never wraps or bleeds -->
        <TextView
            android:id="@+id/slide_kicker"
            style="@style/Kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true" />

        <View
            android:id="@+id/spacer_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="18dp" />

        <TextView
            android:id="@+id/hook_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fraunces_soft_bold"
            android:letterSpacing="-0.01"
            android:lineSpacingMultiplier="1.0"
            android:textColor="@color/hook_ink"
            android:textSize="50sp" />

        <TextView
            android:id="@+id/hook_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/hook_soft"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/slide_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/literata"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/slide_mini_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/quote_rule"
            android:fontFamily="@font/literata"
            android:lineSpacingMultiplier="1.35"
            android:paddingStart="14dp"
            android:textColor="@color/ink_soft"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/slide_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/literata"
            android:lineSpacingMultiplier="1.45"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <View
            android:id="@+id/spacer_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="18dp" />

        <TextView
            android:id="@+id/slide_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/ink_soft"
            android:textSize="13.5sp" />

        <!-- Fine print on every slide: job or tags -->
        <TextView
            android:id="@+id/slide_job"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ink_soft"
            android:textSize="12sp"
            android:textStyle="italic" />
    </LinearLayout>
</ScrollView>
