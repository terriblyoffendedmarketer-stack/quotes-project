<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="26dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <!-- Slide 1, the hook: “How to” in a pill, then the rest of the job as big as it goes. -->
        <TextView
            android:id="@+id/hook_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hook_pill"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:paddingStart="16dp"
            android:paddingTop="7dp"
            android:paddingEnd="16dp"
            android:paddingBottom="7dp"
            android:text="@string/hook_pill"
            android:textColor="@color/hook_pill_ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/slide_kicker"
            style="@style/Kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:id="@+id/spacer_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <TextView
            android:id="@+id/hook_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fraunces_soft_bold"
            android:letterSpacing="-0.01"
            android:lineSpacingMultiplier="1.0"
            android:textColor="@color/hook_ink"
            android:textSize="54sp" />

        <TextView
            android:id="@+id/slide_line"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/literata"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/ink"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/slide_mini_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/quote_rule"
            android:fontFamily="@font/literata"
            android:lineSpacingMultiplier="1.35"
            android:paddingStart="14dp"
            android:textColor="@color/ink_soft"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/slide_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <View
            android:id="@+id/spacer_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <TextView
            android:id="@+id/slide_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <!-- Fine print on every slide after the hook: the job this card is about. -->
        <TextView
            android:id="@+id/slide_job"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink_soft"
            android:textSize="12sp"
            android:textStyle="italic" />
    </LinearLayout>
</ScrollView>
