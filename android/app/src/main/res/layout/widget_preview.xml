<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows: the hook slide, as the widget looks first thing each day. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_hook"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/hook_pill"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:text="@string/hook_pill"
        android:textColor="@color/hook_pill_ink"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:fontFamily="serif"
        android:gravity="center_vertical"
        android:letterSpacing="-0.02"
        android:lineSpacingMultiplier="0.95"
        android:text="@string/preview_hook"
        android:textColor="@color/hook_ink"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:fontFamily="sans-serif-medium"
        android:text="@string/hook_hint"
        android:textColor="@color/hook_soft"
        android:textSize="13sp" />
</LinearLayout>
